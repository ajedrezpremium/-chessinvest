# CHESS INVEST V2.0 - Environment Variables
# Copiar a .env y rellenar. NUNCA commitear .env con secretos.

# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# JWT legacy (solo fallback dev; Auth real = Supabase Auth)
JWT_SECRET=change_me_in_production

# Supabase (Dashboard > Project Settings > API + Database)
SUPABASE_PROJECT_URL=https://xxxxx.supabase.co
SUPABASE_ANON_PUBLIC=eyJhbGciOi...
SUPABASE_SERVICE_ROLE=eyJhbGciOi...
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# AI Providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=CHESSINVEST
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
ANTHROPIC_API_KEY=

# Model router por plan (vacío = usa OPENROUTER_MODEL; último recurso: MODEL_FALLBACK)
MODEL_FREE=
MODEL_BASIC=
MODEL_PRO=
MODEL_PREMIUM=
MODEL_FALLBACK=openrouter/free

# Telegram (opcional; sin esto el newsletter solo sale por web+email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Market data (opcional; Yahoo Finance funciona sin key)
FINNHUB_API_KEY=
ALPHA_VANTAGE_KEY=

# Stripe (pagos)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CHESS INVEST <noreply@chessinvest.com>

# SSL (opcional, solo bare-metal)
SSL_KEY_PATH=
SSL_CERT_PATH=
